@prefix bldg: <bldg-59#> .
@prefix brick: <https://brickschema.org/schema/Brick#> .

bldg:RTU a brick:RTU ;
    brick:feeds bldg:VAV_Box_102,
        bldg:VAV_Box_103,
        bldg:VAV_Box_104,
        bldg:VAV_Box_105,
        bldg:VAV_Box_106,
        bldg:VAV_Box_202,
        bldg:VAV_Box_203,
        bldg:VAV_Box_204,
        bldg:VAV_Box_205,
        bldg:VAV_Box_206 ;
    brick:hasPart bldg:Compressor,
        bldg:Supply_fan ;
    brick:hasPoint bldg:HVAC_TOT_WATT,
        bldg:OCCU_MOD,
        bldg:RTU_GAS_CSUM,
        bldg:RTU_MA_TEMP,
        bldg:RTU_OA_DMPR_DM,
        bldg:RTU_OA_TEMP,
        bldg:RTU_RA_DMPR_DM,
        bldg:RTU_RA_TEMP,
        bldg:RTU_SA_FLOW,
        bldg:RTU_SA_TEMP,
        bldg:RTU_TOT_WATT .

bldg:Compressor a brick:Compressor ;
    brick:hasPoint bldg:RTU_COMP_WATT_1,
        bldg:RTU_COMP_WATT_2 .

bldg:HVAC_TOT_WATT a brick:Electrical_Power_Sensor .

bldg:OCCU_MOD a brick:Occupied_Mode_Status .

bldg:RTU_COMP_WATT_1 a brick:Electrical_Power_Sensor .

bldg:RTU_COMP_WATT_2 a brick:Electrical_Power_Sensor .

bldg:RTU_GAS_CSUM a brick:Gas_Meter .

bldg:RTU_MA_TEMP a brick:Mixed_Air_Temperature_Sensor .

bldg:RTU_OA_DMPR_DM a brick:Damper_Position_Command .

bldg:RTU_OA_TEMP a brick:Outside_Air_Temperature_Sensor .

bldg:RTU_RA_DMPR_DM a brick:Damper_Position_Command .

bldg:RTU_RA_TEMP a brick:Return_Air_Temperature_Sensor .

bldg:RTU_SA_FAN_WATT a brick:Electrical_Power_Sensor .

bldg:RTU_SA_FLOW a brick:Supply_Air_Flow_Sensor .

bldg:RTU_SA_TEMP a brick:Supply_Air_Temperature_Sensor .

bldg:RTU_TOT_WATT a brick:Electrical_Power_Sensor .

bldg:Supply_fan a brick:Supply_Fan ;
    brick:hasPoint bldg:RTU_SA_FAN_WATT .

bldg:TERM_RM_HUMD_102 a brick:Zone_Air_Humidity_Sensor .

bldg:TERM_RM_HUMD_103 a brick:Zone_Air_Humidity_Sensor .

